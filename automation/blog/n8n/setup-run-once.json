    {
      "id": "91f7ad32-3fc3-480b-889c-bc1bc65937e9",
      "name": "Config rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = [\n  ['recipients.approver', 'william@novahavens.com', 'Receives the Friday approval email and the PR link'],\n  ['recipients.ops', 'fazal@novahavens.com', 'Receives error alerts and decline notices'],\n  ['site.url', 'https://www.novahavens.com', 'Canonical site; used to read the sitemap for existing slugs'],\n  ['github.repo', 'Novahavens/Nova-Havens-new', 'owner/repo the PR is opened on'],\n  ['github.base', 'main', 'Base branch for the weekly PR'],\n  ['posts.path', 'apps/web/content/posts', 'Folder the markdown posts are written to'],\n  ['gsc.site', 'sc-domain:novahavens.com', 'Search Console property (only used when the GSC credential exists)'],\n  ['queries.furnished_housing_trends', 'furnished housing | furnished apartments for rent | furnished rentals near me | temporary housing after house fire | corporate housing furnished', 'Pipe-separated Brave searches, past week'],\n  ['queries.furnished_housing_guides', 'how to find furnished housing | furnished rental checklist | what is included in a furnished apartment | short term furnished rental tips | temporary housing while home is repaired', 'Pipe-separated Brave searches, past week'],\n  ['queries.furnished_finder_weekly', 'site:furnishedfinder.com blog | \"Furnished Finder\" blog mid-term rental | furnished finder landlord tips travel nurse housing | mid-term rental landlord blog this week', 'Pipe-separated Brave searches, past week; titles and snippets only (site:…/blog returns nothing)'],\n  ['keywords.disaster_alerts', 'hurricane | wildfire | flood | flooding | tornado | earthquake | storm | evacuation | fema | blizzard | winter storm | disaster | tropical | typhoon | mudslide | landslide', 'Pipe-separated; routes Google Trends items'],\n  ['keywords.furnished_housing_trends', 'furnished | rental | rentals | rent | apartment | housing | relocation | corporate housing | temporary housing | extended stay | airbnb | vrbo | landlord', 'Pipe-separated; routes Google Trends items'],\n  ['keywords.furnished_housing_guides', 'how to | guide | checklist | tips | what to bring | lease | deposit | inventory | move in | move-in', 'Pipe-separated; routes Google Trends items'],\n  ['limits.signals_per_category', '15', 'Top-N signals per category passed to the brief writer'],\n  ['limits.approval_hours', '48', 'Hours the Friday email waits for a decision'],\n];\nreturn rows.map(([key, value, notes]) => ({ json: { key, value, notes } }));"
      }
    },
