      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const split = (v) => String(v || '').split('|').map(s => s.trim()).filter(Boolean);\nconst cfg = {};\nfor (const item of $input.all()) { if (item.json.key) cfg[String(item.json.key).trim()] = String(item.json.value ?? '').trim(); }\nconst queries = {\n  furnished_housing_trends: split(cfg['queries.furnished_housing_trends']),\n  furnished_housing_guides: split(cfg['queries.furnished_housing_guides']),\n  furnished_finder_weekly: split(cfg['queries.furnished_finder_weekly']),\n};\nconst keywords = {\n  disaster_alerts: split(cfg['keywords.disaster_alerts']).map(s => s.toLowerCase()),\n  furnished_housing_trends: split(cfg['keywords.furnished_housing_trends']).map(s => s.toLowerCase()),\n  furnished_housing_guides: split(cfg['keywords.furnished_housing_guides']).map(s => s.toLowerCase()),\n};\nreturn [{ json: { cfg, queries, keywords, siteUrl: cfg['site.url'] || 'https://www.novahavens.com', gscSite: cfg['gsc.site'] || 'sc-domain:novahavens.com', runAt: new Date().toISOString() } }];"
