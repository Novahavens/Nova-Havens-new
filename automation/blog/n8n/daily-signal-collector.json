    {
      "id": "5f211ae2-d66c-4708-872f-d738b268f1ea",
      "name": "Normalise Search Console",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        1280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const data = $input.first().json;\nconst rows = Array.isArray(data && data.rows) ? data.rows : [];\nconst site = $('Build config').first().json.siteUrl;\nreturn rows.slice(0, 50).map(r => ({ json: { source: 'search_console', category: 'other', title: String(r.keys && r.keys[0] || '').trim(), url: site, summary: 'clicks ' + (r.clicks || 0) + ', impressions ' + (r.impressions || 0) + ', avg position ' + Number(r.position || 0).toFixed(1), region: 'US', published: new Date().toISOString(), weight: 0.9, impressions: r.impressions || 0 } })).filter(i => i.json.title);"
      }
    },
    {
      "id": "0ff24203-99fa-4941-9615-d5d75702ad75",
      "name": "Classify, score, dedupe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1552,
        784
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Build config').first().json;\nconst kw = cfg.keywords;\nconst hash = (s) => { let h = 5381; for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) >>> 0; return h.toString(36); };\nconst now = new Date();\nconst seen = new Set();\nconst out = [];\nfor (const { json } of $input.all()) {\n  if (!json || !json.title) continue;\n  const text = (json.title + ' ' + (json.summary || '')).toLowerCase();\n  const hits = (list) => list.filter(k => text.includes(k)).length;\n  let category = json.category;\n  let kwHits = 0;\n  if (category === 'other') {\n    const scores = { disaster_alerts: hits(kw.disaster_alerts), furnished_housing_trends: hits(kw.furnished_housing_trends), furnished_housing_guides: hits(kw.furnished_housing_guides) };\n    const best = Object.entries(scores).sort((a, b) => b[1] - a[1])[0];\n    if (best && best[1] > 0) { category = best[0]; kwHits = best[1]; }\n  } else {\n    kwHits = hits(kw[category] || []);\n  }\n  const key = (json.url && !json.url.endsWith('novahavens.com') ? json.url : json.title).toLowerCase().replace(/[^a-z0-9]+/g, '');\n  const signal_id = category + ':' + hash(key);\n  if (seen.has(signal_id)) continue; seen.add(signal_id);\n  const ageDays = json.published ? Math.max(0, (now - new Date(json.published)) / 86400000) : 2;\n  const recency = isFinite(ageDays) ? Math.max(0.3, 1 - ageDays / 14) : 0.6;\n  const score = Math.round(100 * Math.min(1, (json.weight || 0.5) * recency * (1 + 0.15 * kwHits) * (json.count ? Math.min(1.5, 1 + json.count / 50) : 1) * (json.impressions ? Math.min(1.5, 1 + json.impressions / 500) : 1)));\n  const raw = { ...json }; delete raw.summary; delete raw.title;\n  out.push({ json: { signal_id, collected_at: now.toISOString(), category, source: json.source, title: json.title.slice(0, 200), url: json.url || '', summary: (json.summary || '').slice(0, 400), region: json.region || '', score, raw_json: JSON.stringify(raw).slice(0, 800) } });\n}\nreturn out.sort((a, b) => b.json.score - a.json.score);"
      }
    },
