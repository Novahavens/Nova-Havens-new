    {
      "id": "8c988a1e-37e5-43d2-93d2-9214f5d1f31b",
      "name": "Normalise FEMA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        512
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const data = $input.first().json;\nconst list = Array.isArray(data && data.DisasterDeclarationsSummaries) ? data.DisasterDeclarationsSummaries : [];\nconst since = Date.now() - 7 * 86400000;\nconst byNumber = {};\nfor (const d of list) {\n  const when = Date.parse(d.declarationDate || '');\n  if (!when || when < since) continue;\n  const g = byNumber[d.disasterNumber] || (byNumber[d.disasterNumber] = { ...d, areas: 0 });\n  g.areas += 1;\n}\nreturn Object.values(byNumber).map(d => ({ json: {\n  source: 'fema_declarations', category: 'disaster_alerts',\n  title: (d.declarationType === 'DR' ? 'Major disaster' : d.declarationType === 'EM' ? 'Emergency' : 'Fire management') + ' declaration: ' + (d.declarationTitle || d.incidentType) + ' (' + d.state + ')',\n  url: 'https://www.fema.gov/disaster/' + d.disasterNumber,\n  summary: (d.incidentType || 'Incident') + ' declared ' + String(d.declarationDate || '').slice(0, 10) + '; ' + d.areas + ' designated area(s); incident began ' + String(d.incidentBeginDate || '').slice(0, 10) + '.',\n  region: d.state || '', published: d.declarationDate || '', weight: 1.0\n} }));"
      }
    },
