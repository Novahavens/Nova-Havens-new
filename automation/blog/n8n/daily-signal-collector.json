        "jsCode": "const category = 'furnished_finder_weekly'; const base = 0.6;\nconst out = []; const seen = new Set();\nconst collect = (arr, source) => { for (const r of (Array.isArray(arr) ? arr : [])) {\n  if (!r || !r.url || !r.title || seen.has(r.url)) continue; seen.add(r.url);\n  out.push({ json: { source, category, title: String(r.title).replace(/<[^>]+>/g, '').trim(), url: r.url, summary: String(r.description || (r.extra_snippets && r.extra_snippets[0]) || '').replace(/<[^>]+>/g, '').slice(0, 300), region: 'US', published: r.page_age || r.age || '', weight: source === 'brave_news' ? base + 0.2 : base } });\n} };\nfor (const { json } of $input.all()) { if (!json || json.error) continue; collect(json.web && json.web.results, 'brave_web'); collect(json.news && json.news.results, 'brave_news'); collect(json.results, 'brave_web'); }\nreturn out;"
