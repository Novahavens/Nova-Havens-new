        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ startDate: $today.minus({ days: 10 }).toISODate(), endDate: $today.minus({ days: 3 }).toISODate(), dimensions: [\"query\"], rowLimit: 50 }) }}",
