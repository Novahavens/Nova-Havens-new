        "jsCode": "const rows = $('Classify, score, dedupe').all();\nconst bySource = {}; const byCat = {};\nfor (const { json } of rows) { bySource[json.source] = (bySource[json.source] || 0) + 1; byCat[json.category] = (byCat[json.category] || 0) + 1; }\nreturn [{ json: { run_at: new Date().toISOString(), workflow: $('Config').first().json.workflowName, status: rows.length ? 'ok' : 'empty', items: rows.length, notes: 'by source ' + JSON.stringify(bySource) + ' · by category ' + JSON.stringify(byCat) } }];"
