        "jsCode": "const out = [];\nfor (const { json } of $input.all()) {\n  if (!json || json.error || !json.title) continue;\n  const title = String(json.title).trim();\n  out.push({ json: { source: 'google_trends', category: 'other', title, url: 'https://trends.google.com/trending?geo=US&q=' + encodeURIComponent(title), summary: String(json.contentSnippet || json.content || '').slice(0, 300), region: 'US', published: json.isoDate || json.pubDate || '', weight: 0.8 } });\n}\nreturn out;"
