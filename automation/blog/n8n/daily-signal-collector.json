              "responseFormat": "json"
            }
          }
        }
      },
      "executeOnce": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "0bbc2478-618b-46da-8364-4b14dcf4cc9c",
      "name": "Normalise NWS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const data = $input.first().json;\nconst features = Array.isArray(data && data.features) ? data.features : [];\nconst groups = {};\nfor (const f of features) {\n  const p = f.properties || {};\n  const event = p.event || 'Weather alert';\n  const ugc = (p.geocode && p.geocode.UGC) || [];\n  const states = Array.from(new Set(ugc.map(c => String(c).slice(0, 2))));\n  const g = groups[event] || (groups[event] = { event, count: 0, states: new Set(), headline: p.headline || '', severity: p.severity, url: p['@id'] || 'https://www.weather.gov/alerts', areas: [] });\n  g.count += 1; states.forEach(s => g.states.add(s)); if (g.areas.length < 3 && p.areaDesc) g.areas.push(String(p.areaDesc).split(';')[0]);\n}\nconst rows = Object.values(groups).sort((a, b) => b.count - a.count).slice(0, 12);\nreturn rows.map(g => ({ json: {\n  source: 'nws_alerts', category: 'disaster_alerts',\n  title: g.count + ' active ' + g.event + ' alert' + (g.count === 1 ? '' : 's') + ' (' + (g.severity || 'Severe') + ')',\n  url: g.url, summary: (g.headline || g.event) + '. Areas include ' + g.areas.join('; ') + '.',\n  region: Array.from(g.states).slice(0, 12).join(','), published: new Date().toISOString(), weight: 1.0, count: g.count\n} }));"
      }
    },
