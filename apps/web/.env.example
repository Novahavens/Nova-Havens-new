# ── Public site URL (used for canonical URLs, sitemap, Open Graph) ─────────
# Leave as the production domain. Preview deployments on Vercel still emit
# production canonicals on purpose so previews never compete in search.
NEXT_PUBLIC_SITE_URL=https://novahavens.com

# ── Analytics (all optional) ───────────────────────────────────────────────
# Umami: set both to load the tracker. Leave blank to disable.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX. Leave blank to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Search Console / ownership verification (optional) ─────────────────────
# Paste the content value from the "HTML tag" verification method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Data sync scripts (server-side only, never NEXT_PUBLIC_) ───────────────
# Monday.com API token for scripts/sync-property-stats.ts
MONDAY_API_TOKEN=
# Optional override of the Monday board that holds the property database.
MONDAY_PROPERTY_BOARD_ID=18415735059

# ── Deployment ─────────────────────────────────────────────────────────────
# Set to "standalone" when building for Docker / Replit (not needed on Vercel).
NEXT_OUTPUT=
# Hostname of a remote image CDN for team photos, if not stored in public/team.
TEAM_PHOTO_HOST=
