{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Nova Havens visual tokens extracted from the existing emergency-housing platform. The dark mode values are source-faithful; light mode is a deliberate accessible counterpart. Edit this file only; generated CSS and token exports are rebuilt from it.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F7F7F5", "$description": "Warm near-white page surface for the derived light mode." },
      "foreground": { "$value": "#15171C" },
      "border": { "$value": "#D9DCE1" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#15171C" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#15171C" },
      "primary": {
        "$value": "#D4A24C",
        "$description": "The only gold in the Nova Havens system. Use for buttons, links, compact labels, active states, dividers, and focus."
      },
      "primaryForeground": { "$value": "#0B0D14", "$description": "Near-black text required on gold fills for accessible contrast." },
      "secondary": { "$value": "#ECEEF1" },
      "secondaryForeground": { "$value": "#15171C" },
      "muted": { "$value": "#ECEEF1" },
      "mutedForeground": { "$value": "#5D6672" },
      "accent": { "$value": "#E7E9ED" },
      "accentForeground": { "$value": "#15171C" },
      "destructive": { "$value": "#B42318" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#D9DCE1" },
      "ring": { "$value": "#D4A24C" },
      "chart1": { "$value": "#9C6F27" },
      "chart2": { "$value": "#2D817B" },
      "chart3": { "$value": "#416B86" },
      "chart4": { "$value": "#B85F3E" },
      "chart5": { "$value": "#8061A8" },
      "sidebar": { "$value": "#F0F1F3" },
      "sidebarForeground": { "$value": "#3E4650" },
      "sidebarBorder": { "$value": "#D9DCE1" },
      "sidebarPrimary": { "$value": "#D4A24C" },
      "sidebarPrimaryForeground": { "$value": "#0B0D14" },
      "sidebarAccent": { "$value": "#E7E9ED" },
      "sidebarAccentForeground": { "$value": "#15171C" },
      "sidebarRing": { "$value": "#D4A24C" }
    },
    "dark": {
      "background": { "$value": "#0A0C10", "$description": "Source-faithful Nova Havens page background." },
      "foreground": { "$value": "#F5F5F2" },
      "border": { "$value": "#1D1F2B" },
      "card": { "$value": "#111318" },
      "cardForeground": { "$value": "#F5F5F2" },
      "popover": { "$value": "#111318" },
      "popoverForeground": { "$value": "#F5F5F2" },
      "primary": {
        "$value": "#D4A24C",
        "$description": "The only gold in the Nova Havens system. Use for buttons, links, compact labels, active states, dividers, and focus."
      },
      "primaryForeground": { "$value": "#0B0D14", "$description": "Near-black text required on gold fills for accessible contrast." },
      "secondary": { "$value": "#181B25" },
      "secondaryForeground": { "$value": "#F5F5F2" },
      "muted": { "$value": "#181B25" },
      "mutedForeground": { "$value": "#9BA3AF" },
      "accent": { "$value": "#1D1F2B" },
      "accentForeground": { "$value": "#F5F5F2" },
      "destructive": { "$value": "#DC2828" },
      "destructiveForeground": { "$value": "#F5F5F2" },
      "input": { "$value": "#1D1F2B" },
      "ring": { "$value": "#D4A24C" },
      "chart1": { "$value": "#D4A24C" },
      "chart2": { "$value": "#83C5BE" },
      "chart3": { "$value": "#7A9AB8" },
      "chart4": { "$value": "#D27E5B" },
      "chart5": { "$value": "#B9A1D9" },
      "sidebar": { "$value": "#0D0F14" },
      "sidebarForeground": { "$value": "#F5F5F2" },
      "sidebarBorder": { "$value": "#1D1F2B" },
      "sidebarPrimary": { "$value": "#D4A24C" },
      "sidebarPrimaryForeground": { "$value": "#0B0D14" },
      "sidebarAccent": { "$value": "#1D1F2B" },
      "sidebarAccentForeground": { "$value": "#F5F5F2" },
      "sidebarRing": { "$value": "#D4A24C" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Plus Jakarta Sans", "sans-serif"],
        "$description": "Nova Havens UI, body, label, and heading family."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1rem",
      "$description": "16px source radius for cards; smaller controls derive from this scale."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "4px base rhythm used for spacing and sizing."
    }
  }
}