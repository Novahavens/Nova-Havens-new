{
  "name": "nova-havens",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @nova-havens/web dev",
    "build": "pnpm --filter @nova-havens/web build",
    "start": "pnpm --filter @nova-havens/web start",
    "lint": "pnpm --filter @nova-havens/web lint",
    "typecheck": "pnpm --filter @nova-havens/web typecheck",
    "test:smoke": "pnpm --filter @nova-havens/web test:smoke",
    "sync:property-stats": "pnpm --filter @nova-havens/web sync:property-stats",
    "sync:team": "pnpm --filter @nova-havens/web sync:team",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.5"
  }
}
