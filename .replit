modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "smoke-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/nova-havens exec playwright install chromium && pnpm --filter @workspace/nova-havens test:smoke"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "jsonld"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/nova-havens run validate:jsonld"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "prerender-jsonld"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/nova-havens run validate:prerender"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "artifacts/nova-havens: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/nova-havens"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/nova-havens run dev"
cwd = "./artifacts/nova-havens"
waitForPort = 22035
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "22035"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "parallel"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "token-rule"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "contact-contract"

[[workflows.workflow]]
name = "token-rule"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/nova-havens run test:token-rule"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "contact-contract"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:contact-contract"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[objectStorage]
defaultBucketID = "replit-objstore-ce71f186-0e20-4b61-aa4c-5ba07f1e6668"

[nix]
channel = "stable-25_05"
