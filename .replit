# Replit configuration — kept so the site can still be previewed/deployed on
# Replit. Vercel is the recommended production host (docs/DEPLOYMENT.md).
modules = ["nodejs-22"]
run = "pnpm start"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pnpm install --frozen-lockfile && pnpm build"]
run = ["sh", "-c", "pnpm start"]

[[ports]]
localPort = 3000
externalPort = 80

[workflows]
runButton = "Web"

[[workflows.workflow]]
name = "Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"
